# Copie este archivo como .env para ejecutar el backend fuera de Docker (npm run start:dev)
PORT=3000
CORS_ORIGIN=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=nomina
DB_PASSWORD=nomina
DB_NAME=nomina
DB_LOGGING=false

# Use una cadena larga y aleatoria en producción
JWT_SECRET=cambie-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Usuario administrador que se crea la primera vez (si no hay usuarios)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin123!

# true = crea puestos y empleados de ejemplo si la tabla de empleados está vacía
SEED_DEMO=true

UPLOAD_DIR=uploads

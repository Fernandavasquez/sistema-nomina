# Copie este archivo como .env (en la raíz del proyecto) antes de ejecutar docker compose
DB_USER=nomina
DB_PASSWORD=nomina
DB_NAME=nomina

JWT_SECRET=cambie-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
